{
  "name": "node-boilerplate",
  "version": "1.0.0",
  "main": "dist/src/Index.js",
  "repository": "git@github.com:SaroarShahan/node-boilerplate.git",
  "author": "SaroarShahan",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx watch src/Index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/Index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migration:gen": "sequelize-cli migration:generate --name",
    "model:gen": "sequelize-cli model:generate --name",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo",
    "seed:undo:all": "sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cls-rtracer": "^2.6.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "minio": "^8.0.7",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "biome check --write"
    ]
  },
  "overrides": {
    "cls-rtracer": {
      "uuid": "11.1.1"
    },
    "sequelize": {
      "uuid": "14.0.1"
    }
  },
  "engines": {
    "node": "24.15.0"
  },
  "volta": {
    "node": "24.15.0"
  }
}
